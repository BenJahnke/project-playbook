# Supply-chain policy (needs npm >= 11.17 to be enforced — see the CI
# workflow's Node pin, and the Cloudflare playbook's "Supply chain" section).

# package.json's `allowScripts` is only a warning by default: unreviewed
# install scripts still run. This makes it a hard failure instead.
strict-allow-scripts=true

# Refuse package versions published less than 14 days ago. Hijacked versions
# (compromised maintainer accounts) are usually caught and pulled within
# hours to days — this keeps them from ever landing in the lockfile. Only
# applies when resolving new versions (npm install <pkg> / update / npx):
# npm ci installs whatever is locked regardless of age. For a genuine
# emergency fix younger than this, pass --min-release-age=0 to that one
# install command.
min-release-age=14

# Every dependency comes from the registry today; block git URLs and
# tarball URLs so a transitive dependency can't quietly introduce one.
allow-git=none
allow-remote=none
